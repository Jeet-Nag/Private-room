# ==============================================================================
# PHANTOM ROOM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development or set in your production host.
# NEVER commit real credentials, tokens, or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Port the server listens on (default: 3000)
PORT=3000

# Application environment: development | production | test
NODE_ENV=development

# Enable development HTTPS with local SAN certificates (true | false)
HTTPS=false

# ------------------------------------------------------------------------------
# SECURITY & SESSION SECRETS
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing of ephemeral session tokens.
# In production, set this to a high-entropy string (e.g., openssl rand -hex 32).
# In development, an ephemeral fallback key is generated automatically per restart.
PHANTOM_JWT_SECRET=

# ------------------------------------------------------------------------------
# WEBRTC RELAY / TURN SERVER CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Google public STUN servers are configured by default for NAT traversal.
# Configure TURN credentials below for restrictive firewall/symmetric NAT traversal.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# SPOTIFY CONNECT INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Official Spotify Web Playback SDK / Web API client identifier.
# Only required if enabling synchronized Spotify Connect playback controls.
SPOTIFY_CLIENT_ID=
